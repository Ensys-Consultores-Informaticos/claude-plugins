; Copia este fichero, renombralo a publicar.ini y rellena tus datos.
; publicar.ini NO se versiona: esta en el .gitignore, y la clave no sale de tu
; equipo. Nadie mas la lee, ni queda en ningun historial.

[web]
; La carpeta publica donde se sirven los dos ficheros. HTTPS obligatorio.
; El zip se sirve desde ESTA MISMA carpeta: es el requisito del mismo origen.
url_base = https://www.tudominio.es/claude

; Datos de FTP del hosting.
host = ftp.tudominio.es
usuario = tu_usuario_ftp
clave = tu_clave_ftp

; Carpeta en el servidor que se corresponde con url_base. Suele llevar delante
; algo como /public_html o /httpdocs segun el hosting.
ruta_remota = /public_html/claude

; FTPS (FTP sobre TLS). Dejalo en true salvo que tu hosting no lo admita: en
; false la clave viaja en claro por la red.
tls = true
